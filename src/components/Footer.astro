---
import site from '../data/site.json';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-logo">
        <a href="/" aria-label={site.siteName}>
          <img
            src="/images/brand/scrc-logo-seagull.png"
            alt={site.siteName}
            width="240"
            height="90"
            loading="lazy"
          />
        </a>
      </div>

      <div>
        <p class="footer-tagline">
          People with <strong>Lived Experience</strong> at the centre of cancer research.
        </p>
      </div>

      <div class="footer-actions">
        <div class="social-links" aria-label="Social media">
          <a class="social-link" href="https://twitter.com/Sussex_Cancer" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a class="social-link" href="https://www.linkedin.com/company/sussexcancer" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
          </a>
          <a class="social-link" href="https://www.facebook.com/sussexCancer" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.04c-5.5 0-10 4.49-10 10.02 0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02z"/>
            </svg>
          </a>
          <a class="social-link" href="https://www.instagram.com/Sussex_Cancer" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/>
            </svg>
          </a>
        </div>

        <div style="display:flex; align-items:center; gap:0.85rem; flex-wrap:wrap;">
          <a href="#top" class="btn btn--outline btn--sm">Return to top ↑</a>
          <a href="/donate" class="btn btn--primary btn--sm">Donate</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p style="margin:0;">
        © {year} {site.siteName} · Brighton &amp; Sussex Medical School, University of Sussex, University of Brighton &amp; NHS Trusts across Sussex.
      </p>
      <div class="footer-bottom-links">
        <a href="/contact-us">Contact</a>
        <a href="/press">Press</a>
        <a href="/thankyou">Thank You</a>
        <a href={site.externalLinks.newsletterArchive} target="_blank" rel="noopener noreferrer">Newsletter Archive</a>
      </div>
    </div>
  </div>
</footer>
