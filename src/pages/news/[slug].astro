---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildPeopleNameIndex,
  findMentionedPeopleInNews,
  findPersonByName,
  linkScrcPeopleInHtml,
  type PersonRecord,
} from '../../utils/scrcPeopleLinks';

export async function getStaticPaths() {
  const [posts, people] = await Promise.all([
    getCollection('news'),
    getCollection('people'),
  ]);
  const peopleIndex = buildPeopleNameIndex(people);

  return posts.map((post) => {
    const rawHtml = post.rendered?.html || '';
    const { html: linkedHtml } = linkScrcPeopleInHtml(rawHtml, peopleIndex);
    const mentionedPeople = findMentionedPeopleInNews(post, peopleIndex);
    const authorPerson = findPersonByName(post.data.author, peopleIndex);

    return {
      params: { slug: post.id },
      props: { post, linkedHtml, mentionedPeople, authorPerson },
    };
  });
}

interface Props {
  post: Awaited<ReturnType<typeof getCollection<'news'>>>[number];
  linkedHtml: string;
  mentionedPeople: PersonRecord[];
  authorPerson: PersonRecord | null;
}

const { post, linkedHtml, mentionedPeople, authorPerson } = Astro.props;
const { Content } = await render(post);

const dateFormatted = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt || post.data.title}
  image={post.data.image}
>
  <article class="section section--white">
    <div class="container container--narrow">
      <p style="margin-bottom:1.25rem;">
        <a href="/news" class="read-more">← Back to all News</a>
      </p>

      <div class="card-meta" style="margin-bottom:0.75rem;">
        <time datetime={post.data.date.toISOString()}>{dateFormatted}</time>
        {post.data.author && (
          <span>
            ·{' '}
            {authorPerson ? (
              <a
                href={`/directory/${authorPerson.slug}`}
                class="scrc-author-link"
                title={`View ${authorPerson.name}'s SCRC profile`}
              >
                {post.data.author}
              </a>
            ) : (
              post.data.author
            )}
          </span>
        )}
      </div>

      <h1 style="margin-bottom:1.5rem;">{post.data.title}</h1>

      {post.data.image && (
        <div style="margin-bottom:2rem;">
          <img
            src={post.data.image}
            alt={post.data.title}
            style="width:100%; max-height:520px; object-fit:cover; border-radius:var(--radius-card); box-shadow:var(--shadow-sm);"
          />
        </div>
      )}

      {linkedHtml ? (
        <div class="prose" set:html={linkedHtml} />
      ) : (
        <div class="prose">
          <Content />
        </div>
      )}

      {mentionedPeople.length > 0 && (
        <aside class="mentioned-people" aria-label="SCRC members mentioned in this article">
          <span class="mentioned-people-label">SCRC Members in this Article:</span>
          <div class="mentioned-people-list">
            {mentionedPeople.map((person) => (
              <a
                href={`/directory/${person.slug}`}
                class="scrc-author-link"
                title={`View ${person.name}'s SCRC profile`}
              >
                {person.name}
              </a>
            ))}
          </div>
        </aside>
      )}

      <hr style="border:0; border-top:1px solid var(--scrc-border); margin:3rem 0 2rem;" />
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
        <a href="/news" class="btn btn--outline btn--sm">← All Research News</a>
        <a href="/#involved" class="btn btn--mint btn--sm">Join the SCRC Newsletter</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .mentioned-people {
    margin-top: 2.25rem;
    padding: 1.1rem 1.3rem;
    border-radius: var(--radius-card);
    background: var(--scrc-cream);
    border: 1px solid var(--scrc-border);
  }

  .mentioned-people-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--scrc-muted);
    margin-bottom: 0.65rem;
  }

  .mentioned-people-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
</style>
