---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import publications from '../../data/publications.json';
import rawGrants from '../../data/grants.json';
import {
  buildPeopleNameIndex,
  findMentionedPeopleInNews,
} from '../../utils/scrcPeopleLinks';

interface GrantInvestigator {
  name: string;
  slug?: string;
  role?: string;
}

interface GrantSource {
  label: string;
  url: string;
}

interface Grant {
  title: string;
  funder?: string;
  funderRef?: string;
  amount?: number | null;
  currency?: string;
  startDate?: string;
  endDate?: string;
  startYear?: number | null;
  endYear?: number | null;
  active?: boolean;
  investigators?: GrantInvestigator[];
  scrcMembers?: string[];
  sources?: GrantSource[];
}

export async function getStaticPaths() {
  const [people, newsPosts] = await Promise.all([
    getCollection('people'),
    getCollection('news'),
  ]);

  const peopleIndex = buildPeopleNameIndex(people);
  const newsBySlug = new Map<string, CollectionEntry<'news'>[]>();

  // Map every news post to all SCRC members mentioned in its title or body
  const sortedNews = newsPosts
    .slice()
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  for (const post of sortedNews) {
    const mentioned = findMentionedPeopleInNews(post, peopleIndex);
    for (const member of mentioned) {
      const list = newsBySlug.get(member.slug) || [];
      list.push(post);
      newsBySlug.set(member.slug, list);
    }
  }

  // Map active & 2024+ grants to every SCRC member listed on each grant
  const grantsBySlug = new Map<string, Grant[]>();
  for (const grant of rawGrants as Grant[]) {
    for (const slug of grant.scrcMembers || []) {
      const list = grantsBySlug.get(slug) || [];
      list.push(grant);
      grantsBySlug.set(slug, list);
    }
  }

  return people.map((person) => ({
    params: { slug: person.id },
    props: {
      person,
      memberNews: newsBySlug.get(person.id) || [],
      memberGrants: grantsBySlug.get(person.id) || [],
    },
  }));
}

interface Props {
  person: CollectionEntry<'people'>;
  memberNews: CollectionEntry<'news'>[];
  memberGrants: Grant[];
}

const { person, memberNews, memberGrants } = Astro.props;
const { Content } = await render(person);

function formatGrantAmount(amount: number | null | undefined, currency = 'GBP'): string {
  if (!amount || amount <= 0) return '';
  try {
    return new Intl.NumberFormat('en-GB', {
      style: 'currency',
      currency: currency || 'GBP',
      maximumFractionDigits: 0,
    }).format(amount);
  } catch {
    return `£${Math.round(amount).toLocaleString('en-GB')}`;
  }
}

const SHORT_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function formatGrantDate(iso: string | undefined): string {
  if (!iso) return '';
  const m = iso.match(/^(\d{4})(?:-(\d{2}))?/);
  if (!m) return iso;
  const yr = m[1];
  const mo = m[2] ? Number(m[2]) : 0;
  if (mo >= 1 && mo <= 12 && !iso.endsWith('-01-01') && !iso.endsWith('-12-31')) {
    return `${SHORT_MONTHS[mo - 1]} ${yr}`;
  }
  return yr;
}

function formatGrantRange(startDate?: string, endDate?: string): string {
  const s = formatGrantDate(startDate);
  const e = formatGrantDate(endDate);
  if (s && e) return s === e ? s : `${s} – ${e}`;
  if (s) return `From ${s}`;
  if (e) return `Until ${e}`;
  return '';
}

const FUNDER_ACRONYMS = new Set([
  'UK', 'UKRI', 'MRC', 'BBSRC', 'EPSRC', 'ESRC', 'AHRC', 'NERC', 'STFC',
  'NIHR', 'NHS', 'CRUK', 'ERC', 'EU', 'BHF', 'MNDA', 'BSH', 'SCRC', 'BSMS', 'US', 'USA', 'NIH',
]);
const FUNDER_MINOR = new Set(['of', 'for', 'and', 'the', 'in', 'on', 'to', 'by', 'at', 'with', '&']);

function formatFunderName(raw: string | undefined): string {
  if (!raw) return '';
  const trimmed = raw.trim();
  // Only re-case if the string is predominantly ALL CAPS (common in Elements exports)
  const letters = trimmed.replace(/[^A-Za-z]/g, '');
  if (!letters || letters !== letters.toUpperCase()) return trimmed;
  return trimmed
    .split(/(\s+|-)/)
    .map((tok, idx) => {
      if (!tok || /^\s+$/.test(tok) || tok === '-') return tok;
      const upper = tok.toUpperCase();
      if (FUNDER_ACRONYMS.has(upper)) return upper;
      const lower = tok.toLowerCase();
      if (idx > 0 && FUNDER_MINOR.has(lower)) return lower;
      // Handle alphanumeric tokens like "2NDS" -> "2nds"
      if (/^\d+[a-z]+$/i.test(tok)) return lower;
      return lower.charAt(0).toUpperCase() + lower.slice(1);
    })
    .join('');
}

const cleanImage =
  person.data.image && !person.data.image.toLowerCase().includes('photoholder')
    ? person.data.image
    : '';

const parts = person.data.name.trim().split(/\s+/).filter(Boolean);
const initials =
  parts.length > 1
    ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
    : person.data.name.slice(0, 2).toUpperCase();

// Match publications either via explicit scrcAuthors slug OR "Surname, F." in citation
const cleanNameParts = person.data.name
  .replace(/^(?:prof(?:essor)?\.?|dr\.?|dame|sir)\s+/i, '')
  .trim()
  .split(/\s+/);
const surname = (cleanNameParts[cleanNameParts.length - 1] || '').toLowerCase();
const firstInitial = (cleanNameParts[0] || '')[0]?.toLowerCase() || '';

const memberPubs = publications.filter((pub: any) => {
  if (Array.isArray(pub.scrcAuthors) && pub.scrcAuthors.includes(person.id)) {
    return true;
  }
  if (surname.length >= 3 && firstInitial) {
    const cite = (pub.citation || '').toLowerCase();
    const pattern = new RegExp(`\\b${surname.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')},\\s*${firstInitial}\\.`);
    return pattern.test(cite);
  }
  return false;
});
---

<BaseLayout
  title={person.data.name}
  description={person.data.summary || `${person.data.name} — Member of the Sussex Cancer Research Centre`}
  image={cleanImage || undefined}
>
  <article class="section section--white">
    <div class="container container--narrow">
      <p style="margin-bottom:1.5rem;">
        <a href="/people" class="read-more">← Back to People</a>
      </p>

      <div style="display:flex; flex-wrap:wrap; gap:2rem; align-items:center; margin-bottom:2.25rem;">
        {cleanImage ? (
          <img
            src={cleanImage}
            alt={person.data.name}
            style="width:168px; height:168px; object-fit:cover; object-position:top center; border-radius:var(--radius-card); box-shadow:var(--shadow-sm); flex-shrink:0;"
          />
        ) : (
          <div class="profile-avatar-placeholder" aria-hidden="true">
            <span>{initials}</span>
          </div>
        )}
        <div style="flex:1; min-width:240px;">
          {person.data.managementGroup && (
            <span class="eyebrow">SCRC Leadership &amp; Management</span>
          )}
          <h1 style="margin-bottom:0.5rem;">{person.data.name}</h1>
          {person.data.summary && <p class="lead" style="margin-bottom:0.9rem;">{person.data.summary}</p>}
          {person.data.orcid && (
            <p style="margin-bottom:0.9rem;">
              <a
                href={`https://orcid.org/${person.data.orcid}`}
                target="_blank"
                rel="noopener noreferrer"
                class="orcid-badge"
              >
                <span class="orcid-dot" aria-hidden="true">iD</span>
                <span>orcid.org/{person.data.orcid} ↗</span>
              </a>
            </p>
          )}
          {person.data.interests.length > 0 && (
            <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">
              {person.data.interests.map((interest) => (
                <a href={`/people?interest=${encodeURIComponent(interest)}#directory`} class="tag">
                  {interest}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="prose">
        <Content />
      </div>

      {memberNews.length > 0 && (
        <section style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--scrc-border);">
          <span class="eyebrow">SCRC News</span>
          <h2 style="margin-bottom:1.25rem;">Featured in News</h2>
          <div class="member-news-list">
            {memberNews.map((article) => {
              const dateStr = article.data.date.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              });
              return (
                <article class="member-news-card">
                  {article.data.image && (
                    <a href={`/news/${article.id}`} class="member-news-thumb" tabindex="-1" aria-hidden="true">
                      <img src={article.data.image} alt="" loading="lazy" />
                    </a>
                  )}
                  <div class="member-news-content">
                    <div class="card-meta" style="margin-bottom:0.35rem;">
                      <time datetime={article.data.date.toISOString()}>{dateStr}</time>
                    </div>
                    <h3 class="member-news-title">
                      <a href={`/news/${article.id}`}>{article.data.title}</a>
                    </h3>
                    {article.data.excerpt && (
                      <p class="member-news-excerpt">{article.data.excerpt}</p>
                    )}
                    <a href={`/news/${article.id}`} class="read-more" style="font-size:0.86rem;">
                      Read news article →
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      {memberGrants.length > 0 && (
        <section style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--scrc-border);">
          <span class="eyebrow">Research Funding</span>
          <h2 style="margin-bottom:1.25rem;">Recent Grants</h2>
          <div class="member-grants-list">
            {memberGrants.map((grant) => {
              const amountText = formatGrantAmount(grant.amount, grant.currency);
              const dateRange = formatGrantRange(grant.startDate, grant.endDate);
              const primarySource = (grant.sources || [])[0];
              const coInvestigators = (grant.investigators || []).filter(
                (inv) => inv.slug !== person.id
              );
              return (
                <article class="member-grant-card">
                  <div class="grant-top-row">
                    <div class="grant-badges">
                      {grant.active && <span class="grant-status-pill">Active</span>}
                      {dateRange && <span class="grant-date">{dateRange}</span>}
                    </div>
                    {amountText && <span class="grant-amount">{amountText}</span>}
                  </div>

                  <h3 class="grant-title">
                    {primarySource?.url ? (
                      <a href={primarySource.url} target="_blank" rel="noopener noreferrer">
                        {grant.title}
                      </a>
                    ) : (
                      grant.title
                    )}
                  </h3>

                  {(grant.funder || grant.funderRef) && (
                    <p class="grant-funder">
                      {grant.funder && <span>{formatFunderName(grant.funder)}</span>}
                      {grant.funder && grant.funderRef && <span aria-hidden="true"> · </span>}
                      {grant.funderRef && <span class="grant-ref">{grant.funderRef}</span>}
                    </p>
                  )}

                  {coInvestigators.length > 0 && (
                    <div class="grant-team">
                      <span class="grant-team-label">With:</span>
                      {coInvestigators.slice(0, 6).map((inv) =>
                        inv.slug ? (
                          <a href={`/directory/${inv.slug}`} class="scrc-author-link">
                            {inv.name}
                          </a>
                        ) : (
                          <span class="grant-co-name">{inv.name}</span>
                        )
                      )}
                      {coInvestigators.length > 6 && (
                        <span class="grant-co-name">+{coInvestigators.length - 6} more</span>
                      )}
                    </div>
                  )}

                  {(grant.sources || []).length > 0 && (
                    <div class="grant-sources">
                      {(grant.sources || []).map((src) => (
                        <a
                          href={src.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="grant-source-link"
                        >
                          {src.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      )}

      {memberPubs.length > 0 && (
        <section style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--scrc-border);">
          <span class="eyebrow">Research Outputs</span>
          <h2 style="margin-bottom:1.25rem;">Recent SCRC Publications</h2>
          <div style="display:grid; gap:0.85rem;">
            {memberPubs.map((pub: any) => (
              <details class="member-pub">
                <summary>
                  <span>{pub.citation}</span>
                  <span class="pub-plus" aria-hidden="true">+</span>
                </summary>
                <div class="member-pub-body">
                  {pub.abstract ? (
                    <p>{pub.abstract}</p>
                  ) : (
                    <p style="color:var(--scrc-muted);">Abstract unavailable.</p>
                  )}
                  {pub.doiUrl && (
                    <p style="margin-bottom:0; margin-top:0.65rem;">
                      <a href={pub.doiUrl} target="_blank" rel="noopener noreferrer" class="read-more">
                        View publication via DOI →
                      </a>
                    </p>
                  )}
                </div>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .member-grants-list {
    display: grid;
    gap: 1rem;
  }

  .member-grant-card {
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--scrc-border);
    border-radius: var(--radius-card);
    background: var(--scrc-white);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .member-grant-card:hover {
    border-color: var(--scrc-teal);
    box-shadow: var(--shadow-sm);
  }

  .grant-top-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.5rem;
  }

  .grant-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .grant-status-pill {
    display: inline-block;
    padding: 0.14rem 0.58rem;
    border-radius: 999px;
    background: var(--scrc-mint);
    color: var(--scrc-black);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .grant-date {
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--scrc-muted);
  }

  .grant-amount {
    display: inline-block;
    padding: 0.18rem 0.65rem;
    border-radius: 999px;
    background: var(--scrc-cream);
    border: 1px solid var(--scrc-border);
    color: var(--scrc-black);
    font-size: 0.86rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .grant-title {
    font-size: 1.03rem;
    font-weight: 500;
    line-height: 1.4;
    margin: 0 0 0.4rem;
    color: var(--scrc-black);
  }

  .grant-title a {
    color: var(--scrc-black);
    text-decoration: none;
  }

  .grant-title a:hover {
    color: var(--scrc-teal-deep);
  }

  .grant-funder {
    font-size: 0.88rem;
    color: var(--scrc-muted);
    margin: 0 0 0.55rem;
  }

  .grant-ref {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
  }

  .grant-team {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.65rem;
    font-size: 0.84rem;
  }

  .grant-team-label {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--scrc-muted);
  }

  .grant-co-name {
    font-size: 0.82rem;
    color: var(--scrc-muted);
    padding: 0.04rem 0.35rem;
  }

  .grant-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.55rem;
    border-top: 1px solid rgba(17, 24, 22, 0.07);
  }

  .grant-source-link {
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--scrc-teal-deep);
    text-decoration: none;
  }

  .grant-source-link:hover {
    color: var(--scrc-black);
    text-decoration: underline;
  }
  .member-news-list {
    display: grid;
    gap: 1rem;
  }

  .member-news-card {
    display: flex;
    gap: 1.15rem;
    align-items: flex-start;
    padding: 1.05rem 1.2rem;
    border: 1px solid var(--scrc-border);
    border-radius: var(--radius-card);
    background: var(--scrc-white);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .member-news-card:hover {
    border-color: var(--scrc-teal);
    box-shadow: var(--shadow-sm);
  }

  .member-news-thumb {
    flex-shrink: 0;
    width: 112px;
    height: 84px;
    border-radius: var(--radius-btn);
    overflow: hidden;
    background: var(--scrc-cream);
  }

  .member-news-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .member-news-content {
    flex: 1;
    min-width: 0;
  }

  .member-news-title {
    font-size: 1.04rem;
    font-weight: 500;
    line-height: 1.35;
    margin: 0 0 0.4rem;
  }

  .member-news-title a {
    color: var(--scrc-black);
    text-decoration: none;
  }

  .member-news-title a:hover {
    color: var(--scrc-teal-deep);
  }

  .member-news-excerpt {
    font-size: 0.89rem;
    line-height: 1.58;
    color: var(--scrc-muted);
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .member-news-card {
      flex-direction: column;
    }

    .member-news-thumb {
      width: 100%;
      height: 150px;
    }
  }
  .profile-avatar-placeholder {
    width: 168px;
    height: 168px;
    border-radius: var(--radius-card);
    background: linear-gradient(135deg, var(--scrc-mint-soft) 0%, #d4efe4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .profile-avatar-placeholder span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    border: 2px solid rgba(100, 146, 141, 0.28);
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--scrc-teal-deep);
  }

  .orcid-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: #f2f8ec;
    border: 1px solid #c9e0b1;
    color: #2f4f18;
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
  }

  .orcid-badge:hover {
    background: #e6f2da;
    color: #1f360f;
  }

  .orcid-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #a6ce39;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .member-pub {
    border: 1px solid var(--scrc-border);
    border-radius: var(--radius-btn);
    background: var(--scrc-white);
  }

  .member-pub summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.94rem;
    color: var(--scrc-black);
  }

  .member-pub summary::-webkit-details-marker {
    display: none;
  }

  .pub-plus {
    font-size: 1.25rem;
    line-height: 1;
    color: var(--scrc-teal-deep);
    flex-shrink: 0;
    transition: transform var(--transition);
  }

  .member-pub[open] .pub-plus {
    transform: rotate(45deg);
  }

  .member-pub-body {
    padding: 0.9rem 1.2rem 1.15rem;
    border-top: 1px solid var(--scrc-border);
    font-size: 0.9rem;
    color: var(--scrc-muted);
  }
</style>
