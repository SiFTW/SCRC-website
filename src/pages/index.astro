---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const allNews = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latestNews = allNews.slice(0, 3);

const now = new Date();
const allEvents = (await getCollection('events')).sort(
  (a, b) => a.data.startDate.getTime() - b.data.startDate.getTime()
);
const upcomingEvents = allEvents
  .filter((e) => e.data.startDate.getTime() >= now.getTime() - 86400000)
  .slice(0, 4);
const featuredEvents = upcomingEvents.length > 0 ? upcomingEvents : allEvents.slice(-3).reverse();

const hubs = [
  {
    title: 'Discover Our Research',
    description: 'Leading discovery, translation and survivorship research.',
    href: '/themes',
    cta: 'What we do',
    image: '/images/homev2/hub-research.jpg',
    alt: 'Cancer research team in Sussex laboratories',
  },
  {
    title: 'Lived Experience of Cancer',
    description: 'Get involved, engage with research, and clinical trials.',
    href: '/lived-experience',
    cta: 'Get Involved',
    image: '/images/news/img_0504-2cf7a1c4.png',
    alt: 'People with lived experience shaping cancer research',
  },
  {
    title: 'Support For Researchers',
    description: 'Funding, mentorship, facilities, and vacancies.',
    href: '/research',
    cta: 'For Our Researchers',
    image: '/images/homev2/hub-researchers.jpg',
    alt: 'Cancer researcher in the laboratory',
  },
  {
    title: 'Support Cancer Research',
    description: 'Your support changes lives in Sussex and the world.',
    href: '/donate',
    cta: 'Support us',
    image: '/images/homev2/hub-support.jpg',
    alt: 'Supporting life-changing cancer research in Sussex',
  },
];

const partners = [
  { src: '/images/homev2/partner-sussex.png', alt: 'University of Sussex', tall: true },
  { src: '/images/homev2/partner-bsms.png', alt: 'Brighton and Sussex Medical School', tall: false },
  { src: '/images/homev2/partner-brighton.png', alt: 'University of Brighton', tall: false },
  { src: '/images/homev2/partner-nhs.png', alt: 'NHS Sussex', tall: false },
];

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

function formatMonth(d: Date) {
  return d.toLocaleDateString('en-GB', { month: 'short' });
}

function formatDay(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric' });
}
---

<BaseLayout>
  <!-- Section 1: Streamlined Hero + Institutional Partner Bar (from homev2draft) -->
  <section class="hero hero--v2">
    <img
      src="/images/homev2/hero-researchers.jpg"
      alt="Sussex Cancer Research Centre researchers"
      class="hero-bg"
      width="1500"
      height="1000"
    />
    <div class="hero-overlay hero-overlay--light" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 class="sr-only">Sussex Cancer Research Centre</h1>
      <img
        src="/images/brand/scrc-hero-logo.png"
        alt="Sussex Cancer Research Centre"
        class="hero-logo"
        width="460"
        height="153"
      />
      <p class="hero-mission">
        Uniting university research, NHS trusts, and people with experience of cancer across Sussex
        to translate bench discoveries into life-saving patient care.
      </p>
      <div class="hero-actions">
        <a href="/themes" class="btn btn--primary">What we do</a>
        <a href="/#involved" class="btn btn--mint">Get Involved</a>
      </div>
    </div>
  </section>

  <!-- Partner Institutions Strip -->
  <section class="partner-strip" aria-label="Partner institutions">
    <div class="container">
      <div class="partner-strip-grid">
        {partners.map((partner) => (
          <img
            src={partner.src}
            alt={partner.alt}
            class={partner.tall ? 'partner-logo partner-logo--tall' : 'partner-logo'}
            loading="eager"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: 4 Streamlined Hub Cards (from homev2draft) -->
  <section class="section section--soft">
    <div class="container">
      <div class="grid grid--2 hub-grid">
        {hubs.map((hub) => (
          <article class="card hub-card">
            <a href={hub.href} class="card-media">
              <img src={hub.image} alt={hub.alt} loading="lazy" />
            </a>
            <div class="card-body">
              <h2 class="card-title" style="font-size:1.35rem;">
                <a href={hub.href}>{hub.title}</a>
              </h2>
              <p class="card-excerpt" style="-webkit-line-clamp:unset; font-size:0.98rem;">
                {hub.description}
              </p>
              <div class="card-footer">
                <a href={hub.href} class="btn btn--primary btn--sm">{hub.cta} →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Latest Highlights — News + Upcoming Events (Bright Mint, from homev2draft) -->
  <section class="section section--bright">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Latest Highlights</span>
          <h2 style="margin-bottom:0;">News</h2>
        </div>
        <a href="/news" class="btn btn--primary btn--sm">View All News →</a>
      </div>

      <div class="grid grid--3" style="margin-bottom:4rem;">
        {latestNews.map((post) => (
          <article class="card">
            {post.data.image && (
              <a href={`/news/${post.id}`} class="card-media">
                <img src={post.data.image} alt={post.data.title} loading="lazy" />
              </a>
            )}
            <div class="card-body">
              <div class="card-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </div>
              <h3 class="card-title">
                <a href={`/news/${post.id}`}>{post.data.title}</a>
              </h3>
              {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
              <div class="card-footer">
                <a href={`/news/${post.id}`} class="read-more">Read more →</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="section-header">
        <div>
          <span class="eyebrow">Meetings &amp; Symposia</span>
          <h2 style="margin-bottom:0;">Upcoming Events</h2>
        </div>
        <a href="/events" class="btn btn--primary btn--sm">View All Events →</a>
      </div>

      <div class="grid grid--2">
        {featuredEvents.map((ev) => (
          <article class="card">
            {ev.data.image && (
              <a href={`/events-details/${ev.id}`} class="card-media">
                <img src={ev.data.image} alt={ev.data.title} loading="lazy" />
                <div class="event-date-pill" aria-hidden="true">
                  <span class="event-date-pill__month">{formatMonth(ev.data.startDate)}</span>
                  <span class="event-date-pill__day">{formatDay(ev.data.startDate)}</span>
                </div>
              </a>
            )}
            <div class="card-body">
              <div class="card-meta">
                <time datetime={ev.data.startDate.toISOString()}>{formatDate(ev.data.startDate)}</time>
                {ev.data.location && <span>· {ev.data.location}</span>}
              </div>
              <h3 class="card-title">
                <a href={`/events-details/${ev.id}`}>{ev.data.title}</a>
              </h3>
              {ev.data.excerpt && <p class="card-excerpt">{ev.data.excerpt}</p>}
              <div class="card-footer">
                <a href={`/events-details/${ev.id}`} class="read-more">Read more →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Compact Get Involved & Newsletter Strip -->
  <section class="section section--white section--tight" id="involved">
    <div class="container container--narrow" style="text-align:center;">
      <span class="eyebrow">Join the Community</span>
      <h2>Get Involved &amp; Stay Updated</h2>
      <p class="lead">
        Whether you’re a researcher, clinician, patient, carer, or member of the public, join the
        Sussex Cancer Research Centre to receive our newsletter and updates.
      </p>
      <div style="display:flex; justify-content:center; gap:0.85rem; flex-wrap:wrap; margin-top:1.5rem;">
        <a
          href={site.externalLinks.joinFormUrl}
          target={site.externalLinks.joinFormUrl.startsWith('http') ? '_blank' : undefined}
          rel={site.externalLinks.joinFormUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="btn btn--primary"
        >
          Join the Centre
        </a>
        <a href="/experts" class="btn btn--mint">Experts by Experience</a>
        <a
          href={site.externalLinks.newsletterArchive}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--outline"
        >
          Newsletter Archive ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero--v2 {
    min-height: clamp(320px, 42vh, 420px);
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
    background-color: var(--scrc-mint-soft);
    color: var(--scrc-ink);
  }

  .hero-overlay--light {
    background: linear-gradient(
      98deg,
      rgba(255, 255, 255, 0.94) 0%,
      rgba(255, 255, 255, 0.84) 44%,
      rgba(255, 255, 255, 0.28) 76%,
      rgba(255, 255, 255, 0.04) 100%
    );
  }

  .hero-logo {
    width: min(100%, 440px);
    height: auto;
    margin-bottom: 1.15rem;
  }

  .hero--v2 .hero-mission {
    max-width: 600px;
    font-size: clamp(1rem, 1.3vw, 1.16rem);
    font-weight: 400;
    color: var(--scrc-ink);
    margin-bottom: 1.4rem;
  }

  @media (max-width: 768px) {
    .hero-overlay--light {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.92) 0%,
        rgba(255, 255, 255, 0.82) 70%,
        rgba(255, 255, 255, 0.55) 100%
      );
    }

    .hero-logo {
      width: min(100%, 320px);
    }
  }

  .partner-strip {
    background: var(--scrc-white);
    border-bottom: 1px solid var(--scrc-border);
    padding-block: 1.75rem;
  }

  .partner-strip-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: 1.75rem 2.75rem;
  }

  .partner-logo {
    height: 62px;
    width: auto;
    max-width: 260px;
    object-fit: contain;
    opacity: 0.9;
    transition: opacity var(--transition), transform var(--transition);
  }

  .partner-logo--tall {
    height: 76px;
  }

  .partner-logo:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .partner-logo {
      height: 46px;
      max-width: 170px;
    }

    .partner-logo--tall {
      height: 58px;
    }
  }
</style>
