---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const dateFormatted = event.data.startDate.toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const startTime = event.data.startDate.toLocaleTimeString('en-GB', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/London',
});
const endTime = event.data.endDate
  ? event.data.endDate.toLocaleTimeString('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/London',
    })
  : '';

const mapsUrl = event.data.location
  ? `https://maps.google.com/?q=${encodeURIComponent(event.data.location)}`
  : '';

function toCalStamp(d: Date) {
  return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
}
const gcalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(
  event.data.title
)}&dates=${toCalStamp(event.data.startDate)}/${toCalStamp(
  event.data.endDate || event.data.startDate
)}&location=${encodeURIComponent(event.data.location)}&details=${encodeURIComponent(
  event.data.excerpt || event.data.title
)}`;

// Pick the right sign-up form link for this event
const slugLower = event.id.toLowerCase();
const isLymit = slugLower.includes('lymit');
const isSymposium = slugLower.includes('symposium');
const signupHref =
  event.data.signupUrl ||
  (isLymit
    ? site.externalLinks.lymitFormUrl
    : isSymposium
    ? site.externalLinks.posterAbstractFormUrl
    : site.externalLinks.eventsFormUrl);
const signupLabel =
  event.data.signupLabel ||
  (isLymit
    ? 'Express Interest (LyMIT 2026)'
    : isSymposium
    ? 'Submit Poster Abstract'
    : 'Sign up to attend');
const isExternalSignup = signupHref.startsWith('http');
---

<BaseLayout
  title={event.data.title}
  description={event.data.excerpt || event.data.title}
  image={event.data.image}
>
  <article class="section section--white">
    <div class="container container--narrow">
      <p style="margin-bottom:1.25rem;">
        <a href="/events" class="read-more">← Back to all Events</a>
      </p>

      <h1 style="margin-bottom:1.25rem;">{event.data.title}</h1>

      <div class="callout callout--mint" style="margin-bottom:2rem; display:grid; gap:0.5rem;">
        <div><strong>Date:</strong> {dateFormatted}</div>
        <div>
          <strong>Time:</strong> {startTime}{endTime && endTime !== startTime ? ` – ${endTime}` : ''}
        </div>
        {event.data.location && (
          <div>
            <strong>Location:</strong>{' '}
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">{event.data.location}</a>
          </div>
        )}
        <div style="margin-top:0.75rem; display:flex; gap:0.65rem; flex-wrap:wrap;">
          <a
            href={signupHref}
            target={isExternalSignup ? '_blank' : undefined}
            rel={isExternalSignup ? 'noopener noreferrer' : undefined}
            class="btn btn--primary btn--sm"
          >
            {signupLabel}{isExternalSignup ? ' ↗' : ''}
          </a>
          <a href={gcalUrl} target="_blank" rel="noopener noreferrer" class="btn btn--white btn--sm">
            + Add to Google Calendar
          </a>
          {mapsUrl && (
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline btn--sm">
              View on Map
            </a>
          )}
        </div>
      </div>

      {event.data.image && (
        <div style="margin-bottom:2rem;">
          <img
            src={event.data.image}
            alt={event.data.title}
            style="width:100%; max-height:460px; object-fit:cover; border-radius:var(--radius-card);"
          />
        </div>
      )}

      <div class="prose">
        <Content />
      </div>

      <div class="callout callout--mint" style="margin-top:2.5rem; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem;">
        <div>
          <strong style="display:block; margin-bottom:0.2rem;">Interested in attending?</strong>
          <span style="font-size:0.92rem; color:var(--scrc-muted);">
            Register your interest and receive meeting invitations directly.
          </span>
        </div>
        <a
          href={signupHref}
          target={isExternalSignup ? '_blank' : undefined}
          rel={isExternalSignup ? 'noopener noreferrer' : undefined}
          class="btn btn--primary btn--sm"
        >
          {signupLabel}{isExternalSignup ? ' ↗' : ''}
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
