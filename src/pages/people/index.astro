---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonCard from '../../components/PersonCard.astro';
import featured from '../../data/featured-people.json';
import { getCleanImage, getInitials, resolveFeaturedGroup } from '../../lib/people';

const allPeople = (await getCollection('people')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const bySlug = new Map(allPeople.map((p) => [p.id, p]));

const leadership = resolveFeaturedGroup(featured.leadership, bySlug);
const livedExperience = resolveFeaturedGroup(featured.livedExperience, bySlug);
const management = resolveFeaturedGroup(featured.management, bySlug);

const interestCounts = new Map<string, number>();
allPeople.forEach((p) => {
  p.data.interests.forEach((interest) => {
    interestCounts.set(interest, (interestCounts.get(interest) || 0) + 1);
  });
});
const interests = Array.from(interestCounts.entries()).sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout
  title="People"
  description="Meet the Leadership, Lived Experience, Management, and full membership directory of the Sussex Cancer Research Centre."
>
  <section class="page-banner page-banner--image">
    <img src="/images/brand/hero-sussex.jpg" alt="" class="hero-bg" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container page-banner-inner">
      <h1>People</h1>
      <p class="lead">
        Our researchers, clinicians, and lived-experience partners working together across Brighton
        and Sussex Medical School, University of Sussex, University of Brighton, and NHS Trusts.
      </p>
    </div>
  </section>

  <!-- 1. Leadership -->
  <section class="section section--bright" id="leadership">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Centre Directors</span>
          <h2 style="margin-bottom:0;">Leadership</h2>
        </div>
      </div>

      <div class="grid grid--4">
        {leadership.map((person) => (
          <PersonCard
            slug={person.slug}
            name={person.name}
            role={person.role}
            image={person.image}
            initials={person.initials}
            loading="eager"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 2. Lived Experience -->
  <section class="section section--white" id="lived-experience">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Patients, Carers &amp; Community</span>
          <h2 style="margin-bottom:0;">Lived Experience</h2>
        </div>
        <a href="/experts" class="btn btn--outline btn--sm">Become an Expert by Experience →</a>
      </div>

      <div class="grid grid--3">
        {livedExperience.map((person) => (
          <PersonCard
            slug={person.slug}
            name={person.name}
            role={person.role}
            image={person.image}
            initials={person.initials}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Management -->
  <section class="section section--soft" id="management">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Theme &amp; Strategic Leads</span>
          <h2 style="margin-bottom:0;">Management</h2>
        </div>
      </div>

      <div class="grid grid--4">
        {management.map((person) => (
          <PersonCard
            slug={person.slug}
            name={person.name}
            role={person.role}
            image={person.image}
            initials={person.initials}
            titleSize="1.08rem"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Full Searchable Membership Directory -->
  <section class="section section--white" id="directory">
    <div class="container">
      <span class="eyebrow">All SCRC Members</span>
      <h2>Explore our membership directory by research interest</h2>

      <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem; margin:1.25rem 0 1.5rem;">
        <input
          type="search"
          id="people-search"
          class="search-input"
          placeholder="Search by name, role, institution, or topic..."
          aria-label="Search SCRC members"
        />
        <p style="margin:0; font-size:0.9rem; color:var(--scrc-muted);">
          Showing <strong id="people-count">{allPeople.length}</strong> of {allPeople.length} members
        </p>
      </div>

      <div class="filter-bar" role="group" aria-label="Filter members by research interest" id="interest-filters">
        <button type="button" class="filter-chip is-active" data-interest="all">
          All ({allPeople.length})
        </button>
        {interests.map(([interest, count]) => (
          <button type="button" class="filter-chip" data-interest={interest.toLowerCase()}>
            {interest} ({count})
          </button>
        ))}
      </div>

      <div class="grid grid--4" id="people-grid">
        {allPeople.map((person) => {
          const cleanImg = getCleanImage(person.data.image);
          return (
            <article
              class="card person-card"
              data-search={`${person.data.name} ${person.data.summary} ${person.data.interests.join(' ')}`.toLowerCase()}
              data-interests={person.data.interests.map((i) => i.toLowerCase()).join('|')}
            >
              <a href={`/directory/${person.id}`} class="card-media person-media">
                {cleanImg ? (
                  <img src={cleanImg} alt={person.data.name} loading="lazy" />
                ) : (
                  <div class="avatar-placeholder" aria-hidden="true">
                    <span>{getInitials(person.data.name)}</span>
                  </div>
                )}
              </a>
              <div class="card-body">
                <h3 class="card-title" style="font-size:1.05rem;">
                  <a href={`/directory/${person.id}`}>{person.data.name}</a>
                </h3>
                {person.data.summary && (
                  <p class="card-excerpt" style="-webkit-line-clamp:3; font-size:0.86rem;">
                    {person.data.summary}
                  </p>
                )}
                {person.data.interests.length > 0 && (
                  <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-bottom:0.85rem;">
                    {person.data.interests.slice(0, 3).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
                <div class="card-footer">
                  <a href={`/directory/${person.id}`} class="read-more">Read more →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div id="people-pagination" style="display:flex; justify-content:center; gap:0.75rem; flex-wrap:wrap; margin-top:2.25rem;">
        <button type="button" id="people-load-more" class="btn btn--primary btn--sm">
          Show 48 more
        </button>
        <button type="button" id="people-show-all" class="btn btn--outline btn--sm">
          Show all
        </button>
      </div>
    </div>
  </section>

  <section class="section section--dark section--tight">
    <div class="container container--narrow" style="text-align:center;">
      <h2>Can’t find who you’re looking for?</h2>
      <p class="lead">Get in touch and we’ll put you in touch with the right person.</p>
      <a href="/contact-us" class="btn btn--mint" style="margin-top:0.5rem;">Contact Us</a>
    </div>
  </section>
</BaseLayout>

<script>
  const PAGE_SIZE = 48;
  const searchInput = document.getElementById('people-search') as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-interest]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.person-card'));
  const countEl = document.getElementById('people-count');
  const paginationEl = document.getElementById('people-pagination');
  const loadMoreBtn = document.getElementById('people-load-more');
  const showAllBtn = document.getElementById('people-show-all');

  let activeInterest = 'all';
  let visibleLimit = PAGE_SIZE;

  function updateList() {
    const q = (searchInput?.value || '').trim().toLowerCase();
    const matched: HTMLElement[] = [];
    cards.forEach((card) => {
      const interests = (card.dataset.interests || '').split('|').filter(Boolean);
      const matchInterest = activeInterest === 'all' || interests.includes(activeInterest);
      const matchSearch = !q || (card.dataset.search || '').includes(q);
      if (matchInterest && matchSearch) {
        matched.push(card);
      } else {
        card.style.display = 'none';
      }
    });
    const shown = Math.min(visibleLimit, matched.length);
    matched.forEach((card, idx) => {
      card.style.display = idx < shown ? '' : 'none';
    });
    if (countEl) countEl.textContent = String(matched.length);
    if (paginationEl) {
      paginationEl.style.display = shown < matched.length ? 'flex' : 'none';
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeInterest = chip.dataset.interest || 'all';
      visibleLimit = PAGE_SIZE;
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      updateList();
    });
  });

  searchInput?.addEventListener('input', () => {
    visibleLimit = PAGE_SIZE;
    updateList();
  });

  loadMoreBtn?.addEventListener('click', () => {
    visibleLimit += PAGE_SIZE;
    updateList();
  });

  showAllBtn?.addEventListener('click', () => {
    visibleLimit = cards.length;
    updateList();
  });

  const params = new URLSearchParams(window.location.search);
  const initial = (params.get('interest') || '').toLowerCase();
  if (initial) {
    const match = chips.find((c) => (c.dataset.interest || '') === initial);
    if (match) {
      match.click();
      document.getElementById('directory')?.scrollIntoView({ behavior: 'smooth' });
    }
  } else {
    updateList();
  }
</script>
