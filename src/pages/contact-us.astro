---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const directors = [
  {
    institution: 'Brighton and Sussex Medical School',
    name: 'Prof Simon Mitchell',
    role: 'SCRC Co-Director, Brighton and Sussex Medical School',
    profileHref: '/directory/simon-mitchell',
  },
  {
    institution: 'University of Brighton',
    name: 'Prof Melanie Flint',
    role: 'SCRC Co-Director, University of Brighton',
    profileHref: '/directory/melanie-flint',
  },
  {
    institution: 'University of Sussex',
    name: 'Prof Timothy Humphrey',
    role: 'SCRC Co-Director, University of Sussex',
    profileHref: '/directory/timothy-humphrey',
  },
  {
    institution: 'University Hospitals Sussex NHS Foundation Trust',
    name: 'Dr Duncan Gilbert',
    role: 'SCRC Co-Director, University Hospitals Sussex NHS Foundation Trust',
    profileHref: '/directory/duncan-gilbert',
  },
];

const isExternalForm = site.externalLinks.contactFormUrl.startsWith('http');
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with the Sussex Cancer Research Centre team and our four institutional Co-Directors."
>
  <section class="page-banner page-banner--image">
    <img src="/images/brand/hero-sussex.jpg" alt="" class="hero-bg" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container page-banner-inner">
      <h1>Get in touch</h1>
      <p class="lead">
        Interested in working together? Want to know how you can help? Got a cool idea? We want to
        hear from you.
      </p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="split" style="margin-bottom:3.5rem;">
        <div>
          <span class="eyebrow">General Enquiries</span>
          <h2>Contact the SCRC</h2>
          <p class="lead">
            Send us a message using our online enquiry form or reach our coordination team directly
            by email.
          </p>
          <div style="margin:1.25rem 0 1.5rem;">
            <a
              href={site.externalLinks.contactFormUrl}
              target={isExternalForm ? '_blank' : undefined}
              rel={isExternalForm ? 'noopener noreferrer' : undefined}
              class="btn btn--primary"
            >
              Open Contact Form{isExternalForm ? ' ↗' : ''}
            </a>
          </div>
          <div style="display:grid; gap:0.85rem;">
            <div class="callout callout--mint">
              <strong>General &amp; Research Enquiries:</strong><br />
              <a href={`mailto:${site.email.general}`} style="font-size:1.1rem; font-weight:500;">
                {site.email.general}
              </a>
            </div>
            <div class="callout">
              <strong>Donations &amp; Philanthropy:</strong><br />
              <a href={`mailto:${site.email.donate}`} style="font-size:1.1rem; font-weight:500;">
                {site.email.donate}
              </a>
            </div>
          </div>
        </div>

        <div class="split-media">
          <img
            src="/images/pages/img_2487_jpg-c3978416.jpg"
            alt="Sussex Cancer Research Centre team"
            loading="lazy"
          />
        </div>
      </div>

      <span class="eyebrow">Centre Leadership</span>
      <h2 style="margin-bottom:1.5rem;">SCRC Co-Directors</h2>
      <div class="grid grid--2">
        {directors.map((d) => (
          <div class="callout">
            <span class="tag" style="margin-bottom:0.65rem;">{d.institution}</span>
            <h3 style="margin-bottom:0.35rem;">{d.name}</h3>
            <p style="font-size:0.93rem; color:var(--scrc-muted); margin-bottom:1rem;">{d.role}</p>
            <a href={d.profileHref} class="read-more">View profile →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
