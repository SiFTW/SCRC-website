---
import BaseLayout from '../layouts/BaseLayout.astro';

const resources = [
  {
    title: 'Research Funding',
    description:
      'We aim to support research across the translational pipeline from bench to bedside, with a focus on improving outcomes for people with cancer.',
    href: '/funding',
    cta: 'Apply for funding',
  },
  {
    title: 'Events and Themed Meetings',
    description:
      'We offer a vibrant programme of weekly themed research meetings, symposia, and workshops across Sussex.',
    href: '/events',
    cta: 'View our research events',
  },
  {
    title: 'Mentorship',
    description:
      'The Sussex Cancer Research Centre’s mentorship programme pairs early career researchers with cancer research leaders across our member institutions.',
    href: '/mentor',
    cta: 'Get an SCRC mentor or volunteer',
  },
  {
    title: 'Resources and Equipment',
    description:
      'From sequencing to surveys, we have leading experts ready to collaborate with access to cutting-edge facilities, ethical approval support, and tissue banking.',
    href: '/resources',
    cta: 'View our shared resources',
  },
  {
    title: 'People Directory',
    description:
      'Explore our directory of over 200 researchers, clinicians, and lived-experience partners across BSMS, University of Sussex, University of Brighton, and NHS Trusts.',
    href: '/people#directory',
    cta: 'View our directory of researchers',
  },
  {
    title: 'Publications & Vacancies',
    description:
      'Browse recent peer-reviewed publications from SCRC members or explore current research vacancies across our partner institutions.',
    href: '/publications',
    cta: 'View publications',
    secondaryHref: '/jobs',
    secondaryCta: 'View vacancies',
  },
];
---

<BaseLayout
  title="Support for Researchers"
  description="We support cancer researchers across Sussex through funding, themed meetings, mentorship, shared resources, and collaboration."
>
  <section class="page-banner page-banner--image">
    <img src="/images/homev2/hero-researchers.jpg" alt="" class="hero-bg" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container page-banner-inner">
      <span class="eyebrow">Researcher Hub</span>
      <h1>We support your research through funding, events, mentorship and more</h1>
      <p class="lead">
        Everything you need to connect, collaborate, and translate cancer research from bench to
        bedside across Sussex.
      </p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="split" style="margin-bottom:3.5rem;">
        <div>
          <h2>Built for Cross-Institutional Collaboration</h2>
          <p class="lead">
            Whether you are an early-career researcher, PhD student, laboratory scientist, or NHS
            clinician, SCRC connects you to funding, facilities, mentors, and multidisciplinary
            collaborators across all four partner institutions.
          </p>
          <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1.25rem;">
            <a href="/funding" class="btn btn--primary btn--sm">Apply for Funding</a>
            <a href="/#involved" class="btn btn--mint btn--sm">Join the SCRC</a>
          </div>
        </div>
        <div class="split-media">
          <img
            src="/images/homev2/research-hub-banner.png"
            alt="Sussex Cancer Research Centre researchers"
            loading="lazy"
          />
        </div>
      </div>

      <div class="grid grid--2">
        {resources.map((item) => (
          <article class="callout" style="display:flex; flex-direction:column;">
            <h2 style="font-size:1.35rem; margin-bottom:0.65rem;">{item.title}</h2>
            <p style="color:var(--scrc-muted); margin-bottom:1.35rem; flex:1;">
              {item.description}
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:0.65rem;">
              <a href={item.href} class="btn btn--primary btn--sm">{item.cta} →</a>
              {item.secondaryHref && (
                <a href={item.secondaryHref} class="btn btn--outline btn--sm">
                  {item.secondaryCta}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
